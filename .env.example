DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require
JWT_SECRET=generate-a-long-random-string
PORT=3001

# Google sign-in. The client ID is public (it ships in the browser bundle);
# VITE_ prefix is what exposes it to the front end. Keep any client secret
# out of source — it is not needed for the ID-token flow.
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

# Where the API lives, for deployments that host the front end separately
# (Vercel/Netlify + a server on Render/Railway/Fly). Leave empty for local dev
# and for same-origin deployments — calls stay relative and the proxy handles
# them. No trailing slash, e.g. https://cardfolio-api.onrender.com
# Leave empty on Vercel: api/index.js serves the API on the same origin.
VITE_API_URL=

# ---------------------------------------------------------------- Sending mail
# Verification emails go through Resend (https://resend.com) over plain HTTP —
# no SDK, no dependency. Without a key the server prints the verification link
# to its own console instead, which keeps the whole flow testable in dev.
#
#   1. resend.com -> sign up (free: 3,000 emails a month)
#   2. API Keys -> Create -> copy the value
#   3. paste it below and restart `npm run server`
#
# NOTE on the sender: `onboarding@resend.dev` works out of the box, but Resend
# only lets that shared address deliver to YOUR OWN account email. To send to
# anyone else you have to verify a domain you control and use an address on it,
# e.g. MAIL_FROM=CardFolio <hello@yourdomain.com>.
RESEND_API_KEY=
MAIL_FROM=CardFolio <onboarding@resend.dev>

# The origin the verification link points at — where the front end runs.
# No trailing slash. In production this is your real domain.
APP_URL=http://localhost:5173

# --- Option B: any ordinary mailbox, over SMTP -------------------------------
# Set these three and SMTP is used instead of Resend. This is the way to send
# to ANY recipient without owning a domain — Resend's shared sender refuses
# everyone except your own Resend account address.
#
# Gmail (needs 2-step verification switched on first):
#   1. myaccount.google.com/apppasswords
#   2. create one, copy the 16 characters (spaces do not matter)
#   3. fill in the three below and restart `npm run server`
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop
# MAIL_FROM=CardFolio <you@gmail.com>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
